{
  "name": "alpha-intel-demo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted ALPHA intelligence pipeline with configurable evidence rules and an offline demo",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "check": "node --env-file-if-exists=.env server/cli.mjs check",
    "once": "node --env-file-if-exists=.env server/cli.mjs once",
    "start": "node --env-file-if-exists=.env server/cli.mjs start",
    "status": "node --env-file-if-exists=.env server/cli.mjs status",
    "decisions": "node --env-file-if-exists=.env server/cli.mjs decisions",
    "demo": "node scripts/demo.mjs",
    "demo:json": "node scripts/demo.mjs --json",
    "test": "node --test \"test/**/*.test.mjs\"",
    "preview": "node scripts/preview.mjs"
  }
}

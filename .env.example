# Fill only your local .env; do not share or commit it.
SOCIALDATA_API_KEY=
SCRAPERTECH_API_KEY=
ALPHA_MODEL_API_KEY=
# Optional; keep blank unless using Telegram delivery.
ALPHA_TELEGRAM_BOT_TOKEN=
ALPHA_TELEGRAM_CHAT_ID=
# Live delivery also needs delivery.mode=telegram in your local runtime.json.
ALPHA_ENABLE_LIVE_DELIVERY=0

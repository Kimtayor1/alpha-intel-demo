# 本地产物与个人环境，一律不入库
node_modules/
.pnpm-store/
coverage/
.cache/
.runtime/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
.DS_Store
Thumbs.db
desktop.ini

# 环境变量：.env 本体、变体（.env.production）、备份（.env.bak、.env.old）、
# 以及只带后缀的形态（app.env、deploy.env.local）全部挡住
.env
.env.*
*.env
*.env.*
!/.env.example
*.local
/config/local/

# 备份与临时改动
*.bak
*.bak-*
*.backup
*.orig
*.rej
*.save

# 本地数据：演示不需要，但防止误拷进来
data/
tmp/
out/
.demo-output/
*.csv
*.xlsx

# SQLite / 其它嵌入式库：本体 + WAL/SHM/journal sidecar
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-wal
*.db-shm
*.db-journal
*.db3

# 归档包：备份、导出、快照都可能被打成包
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz
*.zst

# 密钥 / 证书 / 私钥：演示不需要任何一份
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*

# 编辑器
.vscode/
.idea/
*.swp
